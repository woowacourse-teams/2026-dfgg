{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "__LOG_DIR__/dfgg-blue.log",
            "log_group_name": "/dfgg/__ENV__",
            "log_stream_name": "{instance_id}/app-blue",
            "timestamp_format": "%Y-%m-%dT%H:%M:%S.%f",
            "multi_line_start_pattern": "^(\\{|\\d{4}-\\d{2}-\\d{2} )",
            "timezone": "Local",
            "retention_in_days": __RETENTION__
          },
          {
            "file_path": "__LOG_DIR__/dfgg-green.log",
            "log_group_name": "/dfgg/__ENV__",
            "log_stream_name": "{instance_id}/app-green",
            "timestamp_format": "%Y-%m-%dT%H:%M:%S.%f",
            "multi_line_start_pattern": "^(\\{|\\d{4}-\\d{2}-\\d{2} )",
            "timezone": "Local",
            "retention_in_days": __RETENTION__
          },
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/dfgg/__ENV__",
            "log_stream_name": "{instance_id}/nginx-access",
            "retention_in_days": __RETENTION__
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/dfgg/__ENV__",
            "log_stream_name": "{instance_id}/nginx-error",
            "retention_in_days": __RETENTION__
          }
        ]
      }
    }
  }
}
