{
  "uid": "dfgg-service-health",
  "title": "dfgg — 서비스 건강",
  "description": "요구사항 ②의 화면. 앱 지표는 Prometheus, RDS는 CloudWatch, 로그는 CloudWatch Logs에서 온다. 시간 범위가 모든 패널에 공통이라 지표에서 본 이상을 로그에서 바로 따라갈 수 있다.",
  "tags": [
    "dfgg"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dfgg-prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"dfgg-app.*\"}, env)",
          "refId": "env"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "prod",
          "value": "prod"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "서비스 상태",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "살아있는 슬롯",
      "datasource": {
        "type": "prometheus",
        "uid": "dfgg-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dfgg-prometheus"
          },
          "expr": "sum(up{job=~\"dfgg-app.*\", env=\"$env\"})",
          "instant": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "놀고 있는 슬롯은 502라 up=0이 정상이다. 0이 되면 그 환경이 통째로 죽은 것이다."
    },
    {
      "type": "stat",
      "title": "5xx 비율",
      "datasource": {
        "type": "prometheus",
        "uid": "dfgg-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dfgg-prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{env=\"$env\", status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{env=\"$env\"}[5m])), 0.001)",
          "instant": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "요청이 없으면 0으로 보인다. 분모를 clamp_min으로 막아 0 나눗셈을 피한다."
    },
    {
      "type": "stat",
      "title": "추천 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "dfgg-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dfgg-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{env=\"$env\", uri=\"/api/recommendations/v3\"}[5m])) by (le))",
          "instant": true,
          "editorMode": "code"
