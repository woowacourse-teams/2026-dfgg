    {
      "type": "logs",
      "title": "경고 이상 (WARN·ERROR)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "dfgg-cloudwatch"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "description": "지표에서 이상을 보면 시간 범위를 좁힌다. 이 패널도 같은 범위를 따라온다.\n레벨은 원문 정규식으로 잡는다 — parse로 만든 필드에 filter를 걸면 결과가 빈다(실측).",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "dfgg-cloudwatch"
          },
          "queryMode": "Logs",
          "region": "ap-northeast-2",
          "logGroups": [
            {
              "arn": "/dfgg/$env",
              "name": "/dfgg/$env"
            }
          ],
          "expression": "fields @timestamp, @message\n| filter @logStream like \"app-\"\n  and @message =~ /^\\d{4}-\\d{2}-\\d{2} \\S+ (WARN|ERROR) /\n| parse @message /^\\S+ \\S+ (?<level>WARN|ERROR)\\s+\\[(?<slot>[^\\]]*)\\] \\[[^\\]]*\\] (?<logger>\\S+) traceId=(?<traceId>\\S+) - (?<msg>.*)/\n| fields concat(level, \" [\", slot, \"] \", logger, \" - \", msg) as line\n| display @timestamp, line, level, traceId\n| sort @timestamp desc\n| limit 100"
        }
      ]
    }
  ],
  "schemaVersion": 39
