# 모델 묶음을 쓰는 슬롯의 Component 경로. 슬롯의 /models가 묶음을 가리킬 때
# be-deploy-container.yml이 /opt/dfgg/<슬롯>/model.env로 설치한다. 묶음이 아니면 빈 파일을 둔다.
# 컨테이너 환경 변수는 app-config/.env의 같은 키보다 우선한다.
COMPONENT_LTR_MODEL_PATH=file:/models/component/model.json
COMPONENT_LTR_POLICY_LOOKUP_PATH=file:/models/component/component-policy-lookup.json
SITUATIONAL_LOOKUP_PATH=file:/models/component/situational-component-lookup.json
