DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=your_db_url
EVALUATION_DB_URL=your_db_url
EVALUATION_DB_USERNAME=postgres
EVALUATION_DB_PASSWORD=postgres
RIOT_API_KEY=your_riot_api_key_here
COLLECTION_SCHEDULER_ENABLED=true
COLLECTION_SCHEDULER_CRON=10 */2 * * * *
COLLECTION_SCHEDULER_ZONE=Asia/Seoul
COLLECTION_SCHEDULER_TIERS=PLATINUM
COLLECTION_SCHEDULER_DIVISIONS=IV
COLLECTION_SCHEDULER_LEAGUE_PAGE_COUNT=1
COLLECTION_SCHEDULER_PLAYER_PAGE_SIZE=100
COLLECTION_SCHEDULER_PLAYER_LIMIT=1
COLLECTION_SCHEDULER_MATCH_COUNT=47
COLLECTION_SCHEDULER_RECOVER_MISSING_TIMELINES=false
RIOT_RATE_LIMIT_REQUESTS_PER_SECOND=18
RIOT_RATE_LIMIT_REQUESTS_PER_2_MINUTES=95
RECOMMENDATION_V2_MIN_SAMPLE_COUNT=30
RECOMMENDATION_V2_TIERS=PLATINUM,EMERALD,DIAMOND,MASTER,GRANDMASTER,CHALLENGER
ASSETS_S3_BUCKET=bucket
ASSETS_S3_REGION=ap-northeast-2

# v4 API 서빙용. 모델 경로를 비워 두면 Component를 로딩하지 않으며 v4는 503을 반환합니다.
# 기존 v3는 계속 사용할 수 있습니다. 모델과 조회표는 같은 학습 산출물이어야 합니다.
# 모델 예: file:/opt/dfgg/models/component/model.json
# 조회표 예: file:/opt/dfgg/models/component/component-policy-lookup.json
COMPONENT_LTR_MODEL_PATH=
COMPONENT_LTR_POLICY_LOOKUP_PATH=
SITUATIONAL_LOOKUP_PATH=
SITUATIONAL_MIN_LIFT=2.0
SITUATIONAL_MIN_BASE_RATE=0.01

# EC2 Core → Component 연결 검증: bash scripts/component-connection.sh
# 스크립트 실행 환경에 아래 값을 전달합니다. 파일은 EC2의 실제 절대 경로로 변경하세요.
CORE_MODEL_PATH=/opt/dfgg/models/core/model.json
COMPONENT_MODEL_PATH=/opt/dfgg/models/component/model.json
ITEM_CATALOG_PATH=/opt/dfgg/catalog/16.18.1.json

# 확인할 구매 묶음의 예시. 해당 경기·참가자가 DB에 있어야 합니다.
# PURCHASE_ORDER는 묶음 첫 구매의 순번입니다.
MATCH_ID=KR_8375974758
PARTICIPANT_ID=9
PURCHASE_ORDER=34
CORE_TOP_K=5
COMPONENT_OUTPUT_DIR=build/component-connection
