{
  "name": "frontend",
  "version": "1.1.3",
  "description": "League of Legends item build recommendations from the ten champions in your match",
  "main": "dist-desktop/electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "webpack server --mode development",
    "start:desktop:renderer": "webpack server --mode development --env target=desktop",
    "start:desktop": "ow-electron .",
    "build": "webpack --mode production",
    "build:desktop": "webpack --mode production --env target=desktop",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:desktop:plain": "electron .",
    "package:renderer": "pnpm build:desktop && pnpm build:electron",
    "package:desktop": "pnpm package:renderer && electron-builder --win nsis",
    "package:store": "pnpm package:renderer && electron-builder --win appx",
    "package:all": "pnpm package:renderer && electron-builder --win nsis appx",
    "package:publish": "pnpm package:renderer && electron-builder --win nsis --publish always"
  },
  "keywords": [],
  "author": {
    "name": "dfgg"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@overwolf/ow-electron": "^39.8.13",
    "@overwolf/ow-electron-packages-types": "^1.1.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "html-webpack-plugin": "^5.6.8",
    "postcss": "^8.5.25",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "ws": "^8.21.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "@overwolf/ow-electron"
    ]
  },
  "productName": "dfgg",
  "overwolf": {
    "packages": [
      "overlay"
    ]
  },
  "build": {
    "appId": "gg.dfgg.desktop",
    "productName": "dfgg",
    "directories": {
      "output": "release",
      "buildResources": "apps/desktop/build-resources"
    },
    "files": [
      "dist-desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "apps/desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "forceCodeSigning": false,
    "artifactName": "dfgg-setup.${ext}",
    "appx": {
      "identityName": "DFGG.DFGG",
      "publisher": "CN=9DD9FAAE-E9F4-42B1-B663-BF31249E9AB8",
      "publisherDisplayName": "DFGG",
      "applicationId": "dfgg",
      "displayName": "dfgg",
      "backgroundColor": "#0e1428",
      "languages": [
        "ko-KR"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "woowacourse-teams",
        "repo": "2026-dfgg"
      }
    ]
  }
}
