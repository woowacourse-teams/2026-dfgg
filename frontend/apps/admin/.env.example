# apps/admin/.env 로 복사해서 채운다. .env 는 gitignore 대상이라 커밋되지 않는다.

# 키 없이 화면만 볼 때 1
ADMIN_MOCK=0

# 분석 데이터 출처: posthog(기본) | umami
ANALYTICS_SOURCE=posthog

# ── PostHog ───────────────────────────────────────────
# 설정 → Personal API keys 에서 발급. 이 페이지는 읽기만 하므로 query:read 권한이면 충분하다.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=639193
POSTHOG_HOST=https://us.posthog.com

# ── Umami (ANALYTICS_SOURCE=umami 일 때만) ────────────
# cloud.umami.is → Settings → API keys 에서 발급
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=93de5e12-4372-4120-82c0-deab98b3f33a
UMAMI_API_URL=https://api.umami.is/v1

# ── Microsoft Store ───────────────────────────────────
# 기본: Partner Center 에서 내려받은 CSV 를 apps/admin/data/ 에 넣는다 (아래 값은 비워 둔다).
# Entra 앱 키가 있으면 아래를 채워 분석 API 로 바로 가져온다 (회사 계정 필요).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_STORE_APP_ID=9NXL98M7XC82
